SPEECH_BACKEND=pyttsx3
SPEECH_LANGUAGE=en-US
SPEECH_RATE=180
SPEECH_VOLUME=1.0
SPEECH_MAX_CHARS=100000
SPEECH_OUTPUT_DIR=output
SPEECH_DB_ENABLED=false
SPEECH_DB_HOST=127.0.0.1
SPEECH_DB_PORT=3306
SPEECH_DB_NAME=speech_synthesize
SPEECH_DB_USER=speech_app
SPEECH_DB_PASSWORD=change-me
SPEECH_DB_CHARSET=utf8mb4
SPEECH_DB_POOL_SIZE=5
SPEECH_DB_MAX_OVERFLOW=10
SPEECH_DB_CONNECT_TIMEOUT=10
